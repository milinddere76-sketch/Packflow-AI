{
  "name": "packflow-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:sync": "node server-sync.js",
    "start:all": "node server.js & node server-sync.js",
    "start:electron": "electron .",
    "dist:win": "electron-builder --win nsis",
    "cap:init": "npx cap init PackFlow com.packflow.erp --web-dir=.",
    "cap:add:android": "npx cap add android",
    "cap:open:android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "build:www": "echo 'No web build step defined; ensure files are ready in project root'"
  },
  "dependencies": {
    "jsdom": "^21.1.2",
    "express": "^4.18.4",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0"
  }
}
